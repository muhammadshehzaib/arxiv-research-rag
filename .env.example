# Vector Database Configuration (Chroma / Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_research_rag
CHROMA_PATH=data/chroma_db

# Embedding Provider Configuration (Gemini / OpenAI / Ollama)
EMBEDDING_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Models: models/text-embedding-004 (Gemini), text-embedding-3-small (OpenAI)
EMBEDDING_MODEL=models/text-embedding-004

# RAG Generation LLM Configuration (Gemini / OpenAI)
LLM_PROVIDER=gemini
# Models: gemini-1.5-flash (Gemini), gpt-4o-mini (OpenAI)
LLM_MODEL=gemini-1.5-flash

