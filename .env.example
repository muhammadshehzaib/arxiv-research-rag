# Vector Database Configuration (Chroma / Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_research_rag
CHROMA_PATH=data/chroma_db

# Embedding Provider Configuration (Gemini / OpenAI / Ollama)
EMBEDDING_PROVIDER=gemini
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Models: models/gemini-embedding-001 (Gemini), text-embedding-3-small (OpenAI)
EMBEDDING_MODEL=models/gemini-embedding-001

# RAG Generation LLM Configuration (Gemini / OpenAI)
LLM_PROVIDER=gemini
# Models: gemini-2.5-flash (Gemini), gpt-4o-mini (OpenAI)
LLM_MODEL=gemini-2.5-flash

# Web query budgets (seconds; keep total below the Nginx proxy timeout)
QUERY_TIMEOUT_SECONDS=40
MCP_SEARCH_TIMEOUT_SECONDS=12
GEMINI_TIMEOUT_SECONDS=15
EMBEDDING_TIMEOUT_SECONDS=8

# Heuristic retrieval relevance cutoffs (0 < value <= 1), not answer probabilities.
# Validate separately for each reranker/model using scripts.calibrate_threshold.
# Optional provider overrides take precedence over the global fallback.
REFUSAL_THRESHOLD=0.70
# REFUSAL_THRESHOLD_COHERE=0.70
# REFUSAL_THRESHOLD_SENTENCE_TRANSFORMERS=0.70
# REFUSAL_THRESHOLD_FLASHRANK=0.70

# Shared semantic cache: conversation requests bypass it.
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_ENTRIES=500

# Optional held-out dataset: JSON list of question, ground_truth, expected_behavior.
# EVAL_DATASET_PATH=evals/questions.json

# Localhost-only use works without a token. Hosted access requires a strong token.
RAG_AUTH_MODE=local
RAG_API_TOKEN=
RAG_ALLOWED_ORIGINS=
RAG_RATE_LIMIT_PER_MINUTE=60

# Optional comma-separated fallback generation models available to your account.
LLM_FALLBACK_MODELS=
# Generation-only estimates: supply your actual USD rates per million tokens.
RAG_MODEL_PRICING_JSON={}
RAG_ALERT_FAILURE_THRESHOLD=5


